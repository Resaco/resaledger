#!/bin/sh
# agent-ledger: Shape of the records, and the commit gates when code changes (ledger/standards.md).
# Do not bypass with --no-verify; fix the records or the code instead.
for runtime in node bun "$HOME/.bun/bin/bun" /opt/homebrew/bin/node /usr/local/bin/node; do
  if command -v "$runtime" >/dev/null 2>&1; then
    exec "$runtime" ledger/scripts/records.mjs pre-commit
  fi
done
echo "agent-ledger: neither node nor bun was found, so this commit cannot be checked" >&2
exit 1
