#!/bin/sh
# agent-ledger: Commit header and task trailer (ledger/standards.md#commits).
# Do not bypass with --no-verify; fix the message or the ledger instead.
for runtime in node bun "$HOME/.bun/bin/bun" /opt/homebrew/bin/node /usr/local/bin/node; do
  if command -v "$runtime" >/dev/null 2>&1; then
    exec "$runtime" ledger/scripts/records.mjs commit-msg "$1"
  fi
done
echo "agent-ledger: neither node nor bun was found, so this commit cannot be checked" >&2
exit 1
