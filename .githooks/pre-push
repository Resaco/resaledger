#!/bin/sh
# agent-ledger: No pushes straight to a protected branch (.agent-ledger.json).
# Do not bypass with --no-verify; push your branch and open a pull request.
for runtime in node bun "$HOME/.bun/bin/bun" /opt/homebrew/bin/node /usr/local/bin/node; do
  if command -v "$runtime" >/dev/null 2>&1; then
    exec "$runtime" ledger/scripts/records.mjs pre-push "$@"
  fi
done
echo "agent-ledger: neither node nor bun was found, so this push cannot be checked" >&2
exit 1
